# GitLab test automation (Phase 2) — leave GITLAB_URL empty to disable all GitLab features
# GITLAB_URL=https://git.ejad.net
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GitLab's redirect must go to the WEB app (which then calls POST /api/gitlab/oauth/complete),
# never to the API directly, or a stateless callback could bind one user's tokens to another's account.
# Must be <web app URL>/gitlab/callback, matching the redirect URI registered in GitLab exactly.
# GITLAB_OAUTH_REDIRECT_URI=http://localhost:3001/gitlab/callback
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# 0 disables the pipeline poller; any other value must be 1000-3600000 (1s-1h) or it falls back to the default
# GITLAB_POLL_INTERVAL_MS=20000
# GITLAB_RUN_TIMEOUT_MINUTES=120
# Per-request timeout for calls to GitLab's API
# GITLAB_REQUEST_TIMEOUT_MS=15000
